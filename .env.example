# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Your Discord application/client ID (for slash command registration)
CLIENT_ID=

# Optional: restrict slash command deployment to one server while testing.
# Leave blank to deploy globally (can take up to an hour to propagate).
GUILD_ID=

# Chatbot API token from https://api.lebyy.me/dashboard
MIKU_API_TOKEN=

# Default owner name shown to the chatbot API (cosmetic, appears in some replies)
BOT_OWNER_NAME=Shady

# Default language code (see README for the full supported list). "en" = English
DEFAULT_LANGUAGE=en
